# Supabase — create a project at https://supabase.com, then copy
# Project Settings → API into these variables.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_: they are read on the server and
# handed to the browser at request time, so Vercel can store them as private
# values and a key rotation needs no rebuild.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Leave these unset (or as the placeholders above) to run the game in
# guest-only mode — the app degrades gracefully instead of failing to boot.
#
# Never add SUPABASE_SERVICE_ROLE_KEY or a Postgres connection string here:
# this app talks to Supabase over HTTPS with the anon key and row-level
# security, and never needs to bypass RLS.
